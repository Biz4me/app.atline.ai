  price       Decimal?   @db.Decimal(10, 2)
  currency    String     @default("EUR")
  format      String?    // contenance / conditionnement
  imageUrl    String?
  sourceUrl   String?
  extra       Json?      // champs libres selon le MLM
  status      MlmCompanyStatus @default(PUBLISHED)
  position    Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([companyId, slug])
  @@index([companyId])
}

// ═══════════════════════════════════════════════════════════════════════════
// LA BOUCLE DE RÉSULTAT (29 juillet 2026)
//
// Constat : le champ `Interaction.outcome` existait depuis le début et n'était
// jamais rempli. Sans résultat mesuré, un agent ne peut que se souvenir de ce
// qui s'est dit — jamais apprendre de ce qui a marché.
//
// Principe : Atlas est le cerveau, les autres agents sont les ouvriers.
// Chaque action d'ouvrier est journalisée ici, puis MESURÉE automatiquement
// quelques heures ou quelques jours plus tard, en relisant ce qui existe déjà
// (Interaction entrante, PostAnalytics.clicks, Appointment.outcome…).
// Le cerveau lit ces scores la nuit et décide — il ne résume plus.
//
// Aucune IA dans la mesure : ce sont des dates, des jointures et des seuils.
// ═══════════════════════════════════════════════════════════════════════════

enum AgentName {
  ATLAS // piloter
  NOVA  // attirer
  ORION // convertir
  IRIS  // fideliser
  ECHO  // dupliquer
}

enum AgentActionType {
  MESSAGE     // un message envoyé à un contact
  RELANCE     // une relance programmée puis partie
  PUBLICATION // un post publié sur un réseau
  INVITATION  // une demande de mise en relation (LinkedIn)
  APPEL       // un appel passé
  RDV         // un rendez-vous posé
  ETAPE       // une étape de parcours proposée à un filleul
  LECON       // une leçon ou un entraînement proposé
}

enum AgentOutcome {
  EN_ATTENTE // trop tôt pour juger
  REPONDU    // le contact a répondu
  CLIQUE     // le lien a été ouvert
  ACHETE     // une commande a suivi
  RDV_PRIS   // un rendez-vous a été posé
  AVANCE     // le filleul a franchi son étape
  IGNORE     // le délai est passé sans signal
  NEGATIF    // refus explicite, désabonnement, blocage
}

model AgentAction {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent     AgentName
  type      AgentActionType

  contactId String?         // à qui, quand c'est adressé à quelqu'un
  contact   Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  canal     String?         // telegram | whatsapp | linkedin | email | instagram | tel
  sourceId  String?         // id de l'objet d'origine (Relance, ContentPost, Appointment…)
  contenu   String?         @db.Text // ce qui est parti, tronqué — sert à comprendre POURQUOI ça marche
  contexte  Json?           // angle, heure d'envoi, longueur, modèle, produit cité…

  // ── le résultat, écrit plus tard par le mesureur ────────────────────────
  outcome      AgentOutcome @default(EN_ATTENTE)
  outcomeAt    DateTime?    // quand le signal est apparu
  delaiMinutes Int?         // combien de temps s'est écoulé — un signal en soi
  valeur       Float?       // clics, montant… quand c'est chiffrable
  mesureAt     DateTime?    // quand on a tranché
  echeance     DateTime     // au-delà, l'absence de signal vaut IGNORE

  createdAt DateTime        @default(now())

  @@index([userId, agent, createdAt])
  @@index([outcome, echeance])   // le mesureur ne balaie que ce qui est mûr
  @@index([contactId])
}

// ═══════════════════════════════════════════════════════════════════════════
// LA MUTUALISATION (29 juillet 2026) — le fossé concurrentiel
//
// ⚠️ NE PAS CONFONDRE avec `LmsLesson` (82 leçons de FORMATION, du contenu
// rédigé à l'avance, déjà indexé dans Qdrant `atlas-formation`). Ici ce sont
// des CONSTATS : ce que les résultats mesurés révèlent, jamais du contenu.
// La formation enseigne le métier ; les constats disent ce qui marche.
//
// Un distributeur seul n'aura jamais assez de données pour qu'une IA apprenne
// de lui : quelques dizaines d'actions par mois. Deux cents distributeurs de
// la MÊME société, oui. Les leçons remontent donc au niveau de la société,
// et chaque nouveau démarre avec ce que les autres ont appris avant lui.
//
// TROIS GARDE-FOUS, inscrits dans le modèle et pas seulement dans le code :
//
//   1. Aucun contenu personnel ne remonte. Une leçon ne contient que des
//      comptages et un libellé de catégorie — jamais un message, jamais un nom.
//   2. Seuil d'anonymat : une leçon n'existe que si elle repose sur au moins
//      MIN_DISTRIBUTEURS personnes distinctes ET MIN_ACTIONS actions. En
//      dessous, on pourrait remonter à quelqu'un — donc on ne publie pas.
//   3. `distributeurs` est stocké pour que le seuil soit VÉRIFIABLE après coup,
//      pas seulement au moment du calcul.
// ═══════════════════════════════════════════════════════════════════════════

model MlmConstat {
  id        String     @id @default(cuid())
  companyId String
  company   MlmCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  agent  AgentName
  sujet  String // "moment" | "canal" | "angle" — ce qu'on compare
  valeur String // la modalité gagnante : "le soir", "telegram", "question-ouverte"

  // ── les comptages qui la fondent ─────────────────────────────────────────
  actions       Int   // combien d'actions sur cette modalité
  reussites     Int
  taux          Float // reussites / actions
  tauxReference Float // le taux des AUTRES modalités, pour mesurer l'écart
  distributeurs Int   // combien de personnes distinctes — le seuil d'anonymat

  // La phrase telle qu'un agent peut la lire. Construite par comptage, jamais générée.
  enonce String @db.Text

  calculeAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, agent, sujet, valeur])
  @@index([companyId, agent])
}


// ═══════════════════════════════════════════════════════════════════════════
// CE QUE CHATWOOT NOUS DIT (29 juillet 2026)
//
// Le webhook accuse réception vite et enregistre ici. Un traitement séparé
// reprend ces lignes pour faire travailler Orion. Deux raisons de découpler :
// Chatwoot réessaie si on tarde (et le prospect reçoit deux réponses), et une
// panne d'IA ne doit pas faire perdre le message.
// ═══════════════════════════════════════════════════════════════════════════
model ChatwootEvenement {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId      Int      // compte Chatwoot
  conversationId Int
  messageId      Int?
  contactId      String?  // le Contact Atline, quand on a su le retrouver
  canal          String?  // telegram | whatsapp | email | api…
  expediteur     String?
  contenu        String?  @db.Text
  charge         Json?    // la charge utile brute — précieuse tant que le format bouge

  traiteAt       DateTime?  // quand Orion s'en est occupé
  erreur         String?

  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([traiteAt])            // le traitement ne balaie que ce qui reste
  @@index([conversationId])
}
