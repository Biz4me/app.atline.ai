// ============================================================
// §6 — AGENDA & RENDEZ-VOUS
// ============================================================

model Appointment {
  id               String              @id @default(cuid())
  userId           String
  user             User                @relation(fields: [userId], references: [id])
  mlmBusinessId    String?
  mlmBusiness      UserMlmBusiness?    @relation(fields: [mlmBusinessId], references: [id])
  contactId        String?
  contact          Contact?            @relation(fields: [contactId], references: [id])
  title            String
  description      String?
  startAt          DateTime
  endAt            DateTime?
  color            String?
  type             AppointmentType     @default(AUTRE)
  done             Boolean             @default(false)
  outcome          AppointmentOutcome?
  outcomeNote      String?
  atlasDebriefId   String?
  atlasDebrief     AtlasConversation?  @relation(fields: [atlasDebriefId], references: [id])
  calComEventId    String?             @unique
  calComBookingUrl String?
  linkedMlmEventId String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model CalComConnection {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  calComUserId String
  bookingUrl   String
  connected    Boolean   @default(false)
  connectedAt  DateTime?
  updatedAt    DateTime  @updatedAt
}

// LA connexion Google du distributeur — UNE SEULE, quels que soient les usages.
// (ex-CalendarConnection, généralisée le 30 juillet 2026.)
//
// Un distributeur n'a pas « un compte agenda » puis « un compte Gmail » : il a
// UN compte Google, auquel il accorde des permissions qui s'accumulent
// (authUrl pose déjà include_granted_scopes). Deux lignes vers le même compte,
// ce serait deux jetons de rafraîchissement concurrents et surtout deux
// adresses possibles pour un seul expéditeur : la confusion qu'on veut éviter.
//
// `email` n'est donc pas un champ décoratif : c'est L'ADRESSE D'ENVOI, celle
// que le prospect verra. Elle vient de ce que Google a confirmé, JAMAIS de
// User.email — s'inscrire avec son adresse perso et écrire depuis son adresse
// pro est un cas parfaitement légitime.
model GoogleConnection {
  id           String    @id @default(cuid())
  userId       String    @unique
  provider     String    @default("google")
  email        String?
  accessToken  String // chiffré (lib/crypto.ts)
  refreshToken String? // chiffré (lib/crypto.ts)
  expiresAt    DateTime
  scope        String?
  revokedAt    DateTime?

  // ── surveillance des réponses (Gmail push) ─────────────────────────────
  // Quand la surveillance expire. Google la coupe au bout de 7 jours ; un
  // renouvellement oublié, et le distributeur cesse de recevoir les réponses
  // de ses prospects sans que rien ne le signale.
  watchExpiration DateTime?
  // Notre curseur de lecture. On n'avance ce point qu'APRÈS un traitement
  // réussi : une notification perdue se rattrape donc toute seule au coup
  // suivant, puisque l'historique est cumulatif depuis ce curseur.
  historyId       String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Ce qu'on a fait avec l'accès qu'on nous a confié.
//
// C'est la pièce que réclame l'audit CASA : pas une déclaration d'intention,
// une trace. Chaque envoi, chaque lecture, chaque renouvellement de
// surveillance, horodaté et rattaché à l'adresse qui l'a subi.
//
// Ça sert deux fois : à prouver qu'on ne fait que ce qu'on déclare, et à
// répondre au distributeur qui demande « qu'est-ce qui est parti en mon nom ? »
// — question à laquelle on doit pouvoir répondre à la ligne près.
//
// On n'y met JAMAIS le contenu d'un message : un journal d'accès qui recopie
// ce qu'il surveille devient lui-même la fuite qu'il documente.
model GoogleAcces {
  id        String            @id @default(cuid())
  userId    String
  action    GoogleAccesAction
  adresse   String? // l'adresse d'envoi concernée
  ressource String? // identifiant technique (messageId, historyId…), jamais de contenu
  detail    String?
  createdAt DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

enum GoogleAccesAction {
  CONNEXION
  REVOCATION
  ENVOI
  LECTURE
  SURVEILLANCE
  ERREUR
}

// UN FIL E-MAIL AVEC UN PROSPECT — et la boîte qui l'a ouvert.
//
// `adresseEnvoi` est figée à la création et n'est jamais réécrite. Si le
// distributeur change de compte Google, ce fil-là garde son expéditeur
// d'origine ou s'arrête : une conversation commencée depuis une adresse et
// poursuivie depuis une autre casse le fil chez le prospect, qui se demande
// qui lui écrit. Mieux vaut un silence qu'une identité qui glisse.
//
// `echanges` compte les allers-retours pour la bascule forcée vers l'humain,
// et `humainRepris` fige tout dès que le distributeur a écrit lui-même :
// la règle « on n'écrit jamais après un humain », déjà appliquée à Chatwoot.
model EmailFil {
  id               String      @id @default(cuid())
  userId           String
  contactId        String?
  adresseEnvoi     String
  destinataire     String
  sujet            String
  gmailThreadId    String?
  // Message-ID du dernier message du prospect : sans lui, notre réponse
  // ouvre un nouveau fil dans SA boîte au lieu de se rattacher au bon.
  dernierMessageId String?
  // Le texte de sa dernière réponse. On ne conserve QUE les conversations que
  // le distributeur pilote depuis Atline — jamais le reste de sa boîte.
  dernierRecu      String?
  dernierRecuAt    DateTime?
  echanges         Int         @default(0)
  issue            EmailIssue?
  humainRepris     Boolean     @default(false)
  dernierEnvoiAt   DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([userId, updatedAt])
  @@index([gmailThreadId])
  @@index([userId, destinataire])
}

enum EmailIssue {
  RDV
  INSCRIPTION
  ACHAT
  REFUS
  HANDOFF
}

enum AppointmentType {
  CALL
  VISIO
  PRESENTIEL
  WEBINAIRE
  FORMATION
  AUTRE
}

enum AppointmentOutcome {
  POSITIF
  NEUTRE
  NEGATIF
  NO_SHOW
}

// ============================================================
// §7 — ATLAS — CHAT, PLAN DU JOUR & RAPPORTS IA
// ============================================================

model AtlasConversation {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id])
  mlmBusinessId   String?
  mlmBusiness     UserMlmBusiness? @relation(fields: [mlmBusinessId], references: [id])
  contactId       String?
  contact         Contact?         @relation(fields: [contactId], references: [id])
  title           String?
  context         String? // "parcours" | "contact" | "reseau" | "messagerie"
  agent           String           @default("atlas") // "atlas" | "aria" | "nova" — fil d'agent (nav messagerie)
  summary         String? // résumé roulant (compaction : couvre les messages anciens hors fenêtre)
  summarizedCount Int              @default(0) // nb de messages couverts par le résumé
  messages        AtlasMessage[]
  appointments    Appointment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

// Mémoire vivante d'Atlas — faits atomiques (style Memory Kernel) sur l'utilisateur
// (contactId null) ou sur un contact. Jamais de DELETE : un fait contredit passe en
// status=superseded, relié au nouveau. Vocabulaire fermé (prédicats/catégories côté service).
model AtlasFact {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactId      String? // null = fait sur l'utilisateur lui-même
  predicate      String // vise | prefere | bloque_sur | a_decide | ...
  object         String // forme canonique courte
  category       String // objectif | preference | emotion | decision | ...
  source         String   @default("atlas") // qui a appris ce fait : atlas | aria | nova (mémoire partagée, plumes multiples)
  status         String   @default("active") // active | superseded
  confidence     Float    @default(0.75) // 0.55 déduit · 0.75 explicite · 0.9 correction
  supportCount   Int      @default(1) // ré-observations compatibles
  importance     Float    @default(0.5)
  supersededById String?
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([userId, contactId, status])
  @@index([userId, status, importance])
}

model AtlasMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   AtlasConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AtlasRole
  content        String
  qdrantChunks   String[]
  createdAt      DateTime          @default(now())
}

enum AtlasRole {
  USER
  ASSISTANT
}

