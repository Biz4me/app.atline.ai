// Relance programmée (« Atlas n'oublie pas ») — déclenchée par n8n à dueAt
// Une relance à faire. Sert depuis toujours aux rappels ponctuels (plan du
// jour, message du matin, actions d'Atlas) ; porte aussi, depuis le 30 juillet
// 2026, les étapes d'une séquence e-mail. Volontairement UNE seule table : le
// distributeur ne veut pas deux listes de choses à faire.
model Relance {
  id        String    @id @default(cuid())
  userId    String
  contactId String
  channel   String    @default("email") // whatsapp | sms | email
  dueAt     DateTime
  // PENDING (programmée, puis à valider une fois l'échéance passée)
  // VALIDATED (le distributeur a dit oui, en file d'envoi — le plafond
  //            quotidien et l'espacement peuvent la faire patienter)
  // SENT | CANCELLED
  status    String    @default("PENDING")
  message   String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  // ── séquence e-mail ────────────────────────────────────────────────────
  // Rang dans la séquence (1 à 4). Nul pour une relance ponctuelle.
  etape      Int?
  emailFilId String?
  // Pourquoi la séquence s'est arrêtée : « le prospect a répondu »,
  // « rendez-vous pris »… Sert à l'expliquer, pas seulement à l'enregistrer.
  raisonFin  String?

  @@index([status, dueAt])
  @@index([userId, status, dueAt])
  @@index([emailFilId])
}

// ── Société MLM : fiche partagée, faite 1× par (marque, pays), dont héritent les
// distributeurs. Champs requêtés en colonnes ; les 8 rubriques vivent dans `fiche`
// (JSON, évolue sans migration). `sources` = provenance + confiance par champ (étage 3).
// Défauts France ; l'international = une autre ligne même brandSlug, autre country.
enum MlmCompanyStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

model MlmCompany {
  id          String   @id @default(cuid())
  brandSlug   String
  slug        String   @unique
  name        String
  country     String   @default("FR")
  locale      String   @default("fr-FR")
  currency    String   @default("EUR")
  category    String?
  officialUrl String?
  // ── PRÉSENCE FRANCE (29 juillet 2026) ────────────────────────────────
  // Le champ qui manquait : notre base était riche en sociétés américaines
  // et vide là où un distributeur français cherche. Sourcé de la FVD
  // (fédération, donc vérifié), d'Epixel et de Réussir VDI.
  franceOperee  Boolean  @default(false)
  siret         String?  // identité légale française — vérifiable, contrairement à une URL
  fvdMembre     Boolean  @default(false)
  fvdDepuis     Int?     // année d'adhésion à la Fédération de la Vente Directe
  anneeCreation Int?
  // ⚠️ Chiffre d'affaires MONDIAL du groupe, en millions — surtout pas français.
  caMondialM    Float?

  status      MlmCompanyStatus @default(DRAFT)
  fiche       Json     @default("{}")
  sources     Json?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  businesses UserMlmBusiness[]
  products   MlmProduct[]

  @@unique([brandSlug, country])
  @@index([brandSlug])
  constats    MlmConstat[]

}

// Catalogue produit STRUCTURÉ par société (≠ la fiche narrative). Atlas y lit le prix
// de façon déterministe (pas via le RAG), et Nova s'en sert pour la publication.
